# Copy this file to .env and fill in your own values
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=realestatephp
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase web app configuration (public identifiers, not private credentials).
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your_firebase_web_app_id

# EstateScope Password Reset Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="EstateScope Support"

# Optional Leaflet map services. Defaults use OpenStreetMap tiles and Nominatim geocoding.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# LEAFLET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# LEAFLET_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
